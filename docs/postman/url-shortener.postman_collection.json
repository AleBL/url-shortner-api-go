    {
      "name": "Redirect to original URL",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/{{shortCode}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{shortCode}}"
          ]
        },
        "description": "The public short link returned by `POST /shorten`. Redirects (`302 Found`) to the original URL.\n\nAutomatic redirect following is disabled for this request so the `Location` header is visible."
      },
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 302', () => pm.response.to.have.status(302));",
              "pm.test('has Location header', () => pm.response.to.have.header('Location'));"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "Redirect",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{shortCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{shortCode}}"
              ]
            }
          },
          "status": "Found",
          "code": 302,
          "header": [
            {
              "key": "Location",
              "value": "https://go.dev/doc"
            }
          ],
          "body": ""
        },
        {
          "name": "Unknown code",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{shortCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{shortCode}}"
              ]
            }
          },
          "status": "Not Found",
          "code": 404,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ],
          "body": "{\"error\": \"URL not found\"}",
          "_postman_previewlanguage": "json"
        }
      ]
    },
    {
      "name": "Get original URL",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/urls/{{shortCode}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "urls",
            "{{shortCode}}"
          ]
        },
        "description": "Returns the original URL for a short code as JSON, without redirecting."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('returns originalURL', () => pm.expect(pm.response.json().originalURL).to.match(/^https?:\\/\\//));"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "Found",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/urls/{{shortCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "urls",
                "{{shortCode}}"
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
